# AI SDLC SaaS local/staging environment template (copy to .env; never commit real secrets)
AI_SDLC_ENV=development
AI_SDLC_DATABASE_URL=sqlite:///./.local_dev/ai_sdlc.db
AI_SDLC_OBJECT_STORE_DIR=./.local_dev/object_store
AI_SDLC_WORKTREE_ROOT=./.local_dev/worktrees
AI_SDLC_JWT_SECRET=change-me-local-dev-jwt-secret-min-32-bytes
AI_SDLC_ENCRYPTION_KEY=
AI_SDLC_GITHUB_WEBHOOK_SECRET=change-me-local-github-webhook-secret
AI_SDLC_STRIPE_WEBHOOK_SECRET=change-me-local-stripe-webhook-secret
AI_SDLC_ALLOW_LOCAL_GATEWAY=true
AI_SDLC_ALLOW_LOCAL_GIT_REPOS=true
NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_API_KEY=
AI_SDLC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
